{
  "name": "ai4s-dashboard",
  "private": true,
  "engines": { "node": ">=24" },
  "scripts": {
    "build": "node build.js",
    "mock": "node build.js --mock",
    "content:verify": "node scripts/local-content.cjs verify",
    "content:build": "node build.js --local",
    "content:preview": "node scripts/preview-local.cjs",
    "test": "node --test --test-concurrency=1 test/*.test.js",
    "render:payload": "node payload-dashboard-kit/render.mjs"
  }
}
