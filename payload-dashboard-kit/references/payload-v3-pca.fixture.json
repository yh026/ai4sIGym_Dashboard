  "sections": [
    {
      "id": "pca-section",
      "title": "Principal component analysis",
      "short_label": "PCA",
      "summary": "Six panels state the retained dimension and expose what the projection preserves or loses.",
      "narrative": ["The retained dimension is chosen from cumulative explained variance, then checked against loadings and covariance residuals."],
      "metrics": [
        {"name": "retained components", "value": 5},
        {"name": "retained variance", "value": 0.91, "unit": "fraction"}
      ],
      "checks": [
        {"id": "variance-threshold", "label": "Cumulative variance at or above 90%", "result": "pass"}
      ],
      "caveats": ["The fixture values are illustrative and are not scientific results."],
      "figure_ids": ["pca-diagnostics"],
      "initial_state": "open"
    }
  ],
  "figures": [
    {
      "id": "pca-diagnostics",
      "title": "PCA diagnostics",
      "caption": "Scree, loadings, correlation circle, and residual covariance views share one explicit composite specification.",
      "recipe": "pca.diagnostics@1",
      "recipe_config": {
        "bindings": {
          "scree": {"data": "pca-scree", "component": "component", "variance": "explained_variance", "cumulative": "cumulative_variance"},
          "loadings": {"data": "pca-loadings", "component": "component", "feature": "feature", "value": "loading"},
          "circle": {"data": "pca-circle", "label": "feature", "x": "pc1", "y": "pc2"},
          "residuals": {"data": "pca-residuals", "component": "component_count", "row": "feature_y", "column": "feature_x", "value": "residual"}
        },
        "params": {
          "variance_threshold": 0.9,
          "selected_components": 5,
          "residual_components": [2, 6, 8]
        }
      },
      "layout": {
        "type": "grid",
        "columns": 3,
        "rows": 2,
        "gap": 16
      },
      "panels": [
        {
          "id": "pca-scree-panel",
          "title": "Explained variance",
          "data_ref": "pca-scree",
          "coordinate": {"type": "cartesian"},
          "layers": [
            {
              "id": "pca-scree-bars",
              "mark": {"type": "bar", "orient": "vertical", "opacity": 0.88},
              "encoding": {
                "x": {"field": "component", "type": "ordinal", "title": "Component", "axis": {"title": "Principal component", "format": "integer"}},
                "y": {"field": "explained_variance", "type": "quantitative", "title": "Explained variance", "axis": {"title": "Variance", "format": "percent", "grid": true}},
                "color": {"value": "variance", "type": "nominal", "scale_role": "semantic"}
              }
            },
            {
              "id": "pca-cumulative-line",
              "mark": {"type": "line", "stroke_width": 2.5},
              "encoding": {
                "x": {"field": "component", "type": "ordinal", "axis": false},
                "y": {"field": "cumulative_variance", "type": "quantitative", "axis": false},
                "stroke": {"value": "cumulative", "type": "nominal", "scale_role": "semantic"}
              }
            }
          ],
          "annotations": [
            {"id": "pca-variance-target", "type": "rule", "description": "90% target", "encoding": {"y": {"value": 0.9, "type": "quantitative"}, "color": {"value": "reference", "type": "nominal"}}},
            {"id": "pca-selected-l", "type": "rule", "description": "L = 5", "encoding": {"x": {"value": 5, "type": "ordinal"}, "color": {"value": "selection", "type": "nominal"}}}
          ]
        },
        {
          "id": "pca-loading-panel",
          "title": "Loading matrix",
          "type": "matrix",
          "data_ref": "pca-loadings",
          "coordinate": {"type": "matrix"},
          "layers": [
            {
              "id": "pca-loading-cells",
              "mark": {"type": "rect"},
              "encoding": {
                "x": {"field": "component", "type": "ordinal", "title": "Component", "axis": {"title": "Component", "format": "integer"}},
                "y": {"field": "feature", "type": "nominal", "title": "Feature", "axis": {"title": "Feature"}},
                "color": {"field": "loading", "type": "quantitative", "title": "Loading", "scale_role": "diverging", "legend": {"title": "Loading"}},
                "tooltip": {"field": "loading", "type": "quantitative", "title": "Loading"}
              }
            }
          ]
        },
        {
          "id": "pca-circle-panel",
          "title": "Correlation circle",
          "data_ref": "pca-circle",
          "coordinate": {"type": "cartesian"},
          "layers": [
            {
              "id": "pca-unit-circle",
              "mark": {"type": "ellipse", "role": "reference", "stroke_width": 1.5},
              "encoding": {
                "x": {"value": 0, "type": "quantitative"},
                "y": {"value": 0, "type": "quantitative"},
                "x_radius": {"value": 1, "type": "quantitative"},
                "y_radius": {"value": 1, "type": "quantitative"},
                "color": {"value": "reference", "type": "nominal", "scale_role": "semantic"}
              }
            },
            {
              "id": "pca-circle-vectors",
              "mark": {"type": "vector", "stroke_width": 2},
              "encoding": {
                "x": {"field": "origin_x", "type": "quantitative", "axis": {"title": "PC1", "format": "number", "grid": true}},
                "y": {"field": "origin_y", "type": "quantitative", "axis": {"title": "PC2", "format": "number", "grid": true}},
                "x2": {"field": "pc1", "type": "quantitative"},
                "y2": {"field": "pc2", "type": "quantitative"},
                "color": {"field": "feature", "type": "nominal", "scale_role": "semantic", "legend": false}
              }
            },
            {
              "id": "pca-circle-labels",
              "mark": {"type": "text"},
              "encoding": {
                "x": {"field": "pc1", "type": "quantitative", "axis": false},
                "y": {"field": "pc2", "type": "quantitative", "axis": false},
                "text": {"field": "feature", "type": "nominal"}
              }
            }
          ]
        },
        {
          "id": "pca-residual-2-panel",
          "title": "Covariance residual, L = 2",
          "type": "matrix",
          "data_ref": "pca-residuals",
          "coordinate": {"type": "matrix"},
          "transform": [{"op": "filter", "field": "component_count", "predicate": {"eq": 2}}],
          "layers": [
            {
              "id": "pca-residual-2-cells",
              "mark": {"type": "rect"},
              "encoding": {
                "x": {"field": "feature_x", "type": "nominal", "axis": {"title": "Feature"}},
                "y": {"field": "feature_y", "type": "nominal", "axis": {"title": "Feature"}},
                "color": {"field": "residual", "type": "quantitative", "scale_role": "diverging", "legend": {"title": "Residual"}}
              }
            }
          ]
        },
        {
          "id": "pca-residual-6-panel",
          "title": "Covariance residual, L = 6",
          "type": "matrix",
          "data_ref": "pca-residuals",
          "coordinate": {"type": "matrix"},
          "transform": [{"op": "filter", "field": "component_count", "predicate": {"eq": 6}}],
          "layers": [
            {
              "id": "pca-residual-6-cells",
              "mark": {"type": "rect"},
              "encoding": {
                "x": {"field": "feature_x", "type": "nominal", "axis": {"title": "Feature"}},
                "y": {"field": "feature_y", "type": "nominal", "axis": {"title": "Feature"}},
                "color": {"field": "residual", "type": "quantitative", "scale_role": "diverging", "legend": {"title": "Residual"}}
              }
            }
          ]
        },
        {
          "id": "pca-residual-8-panel",
          "title": "Covariance residual, L = 8",
          "type": "matrix",
          "data_ref": "pca-residuals",
          "coordinate": {"type": "matrix"},
          "transform": [{"op": "filter", "field": "component_count", "predicate": {"eq": 8}}],
          "layers": [
            {
              "id": "pca-residual-8-cells",
              "mark": {"type": "rect"},
              "encoding": {
                "x": {"field": "feature_x", "type": "nominal", "axis": {"title": "Feature"}},
                "y": {"field": "feature_y", "type": "nominal", "axis": {"title": "Feature"}},
                "color": {"field": "residual", "type": "quantitative", "scale_role": "diverging", "legend": {"title": "Residual"}}
              }
            }
          ]
        }
      ],
      "interactions": [
        {"id": "pca-loading-tooltip", "type": "tooltip", "targets": ["pca-loading-panel/pca-loading-cells"], "fields": ["feature", "component", "loading"], "mode": "pointer"}
      ]
    }
  ]
}
